{
    https_port 8443
    http_port 8081
}

mcp-zabbix.beonup.com.br:8443 {
    # Certificado auto-assinado interno (sem depender de Let's Encrypt ou Route53)
    tls internal

    # MCP Server (Streamable HTTP) — requer Authorization header
    handle /mcp {
        @no_auth {
            not header Authorization *
        }
        respond @no_auth "Authorization header required" 401
        reverse_proxy mcp-server:8001
    }

    # API REST
    handle /api/* {
        reverse_proxy api:3000
    }

    # Frontend (React SPA)
    handle {
        reverse_proxy frontend:80
    }
}

# HTTP na 8081 — redireciona para HTTPS
mcp-zabbix.beonup.com.br:8081 {
    redir https://mcp-zabbix.beonup.com.br:8443{uri} permanent
}
