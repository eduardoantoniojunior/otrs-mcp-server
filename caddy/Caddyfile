:80 {
    # MCP Server (Streamable HTTP)
    handle /mcp {
        reverse_proxy mcp-server:8001
    }
    
    # MCP Server (FastMCP SSE)
    handle /sse {
        reverse_proxy mcp-server:8001
    }
    
    handle /messages {
        reverse_proxy mcp-server:8001
    }

    # API REST
    handle /api/* {
        reverse_proxy api:3000
    }

    # Frontend (React SPA)
    handle {
        reverse_proxy frontend:80
    }
}
