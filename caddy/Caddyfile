{
    # Portas alternativas (80 e 443 já ocupadas por outro serviço na mesma EC2)
    http_port 8080
    https_port 8443
}

{$DOMAIN:localhost}:8443 {
    # HTTPS via Let's Encrypt com DNS Challenge (Route53)
    # Não depende das portas 80/443 — valida via DNS TXT record
    # Credenciais AWS: usa IAM Role da EC2 ou env vars AWS_ACCESS_KEY_ID/SECRET
    tls {$EMAIL:internal} {
        dns route53 {
            region {$AWS_REGION:us-east-1}
        }
    }

    # MCP Server (Streamable HTTP)
    # Rota exata /mcp — requer Authorization header
    handle /mcp {
        @no_auth {
            not header Authorization *
        }
        respond @no_auth "Authorization header required" 401
        reverse_proxy mcp-server:8001
    }

    # API REST
    handle /api/* {
        reverse_proxy api:3000
    }

    # Frontend (React SPA)
    handle {
        reverse_proxy frontend:80
    }
}
