:80 {
    # MCP Server (Streamable HTTP)
    # Requer header Authorization com API key válida
    # A validação real é feita pelo backend, mas podemos bloquear requests sem header
    handle /mcp* {
        @no_auth {
            not header Authorization *
        }
        respond @no_auth "Authorization header required" 401
        reverse_proxy mcp-server:8001
    }
    
    # (SSE e /messages removidos — servidor migrado para Streamable HTTP em /mcp)

    # API REST
    handle /api/* {
        reverse_proxy api:3000
    }

    # Frontend (React SPA)
    handle {
        reverse_proxy frontend:80
    }
}
