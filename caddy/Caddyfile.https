# =============================================================================
# OTRS MCP Server — Caddy com HTTPS (Let's Encrypt via DNS Challenge Route53)
# =============================================================================
# Para usar este arquivo, renomeie para Caddyfile:
#   cp Caddyfile.https Caddyfile
#
# Requer:
#   - Caddy com plugin caddy-dns/route53 (ver Dockerfile)
#   - .env com DOMAIN, EMAIL e AWS_REGION definidos
#   - IAM Role da EC2 com permissão route53:ChangeResourceRecordSets
#   - Registro A no Route53: DOMAIN -> IP da EC2
#   - Porta 8443 aberta no Security Group
# =============================================================================

{
    https_port 8443
}

{$DOMAIN} {
    tls {$EMAIL} {
        dns route53 {
            region {$AWS_REGION:us-east-1}
        }
    }

    # MCP Server (Streamable HTTP) — requer Authorization header
    handle /mcp {
        @no_auth {
            not header Authorization *
        }
        respond @no_auth "Authorization header required" 401
        reverse_proxy mcp-server:8001
    }

    # API REST
    handle /api/* {
        reverse_proxy api:3000
    }

    # Frontend (React SPA)
    handle {
        reverse_proxy frontend:80
    }
}
