# OTRS MCP Server - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# OTRS (obrigatorio)
OTRS_BASE_URL=https://your-otrs-instance/otrs/nph-genericinterface.pl/Webservice/TestInterface
OTRS_USERNAME=your-username
OTRS_PASSWORD=your-password

# OTRS (opcional)
OTRS_VERIFY_SSL=true
OTRS_TIMEOUT=30
OTRS_DEBUG=false
OTRS_DEFAULT_QUEUE=Raw
OTRS_DEFAULT_STATE=new
OTRS_DEFAULT_PRIORITY=3 normal
OTRS_DEFAULT_TYPE=Unclassified
OTRS_WEB_BASE_URL=https://your-otrs-instance/otrs

# CORS
OTRS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# JWT (obrigatorio para auth do frontend)
OTRS_JWT_SECRET=change-me-in-production-use-a-real-secret-min-32-chars
OTRS_JWT_EXPIRE_MINUTES=480

# Admin padrao (criado automaticamente na primeira execucao)
OTRS_ADMIN_USER=admin
OTRS_ADMIN_PASSWORD=admin123

# MCP Server
OTRS_MCP_TRANSPORT=http
OTRS_MCP_HOST=0.0.0.0
OTRS_MCP_PORT=8001

# Database
OTRS_DB_PATH=/data/otrs-mcp.db

# Monitoramento de atividade
OTRS_ACTIVITY_FILE=/data/activity.json
OTRS_ACTIVITY_MAX_EVENTS=1000

# Caddy (HTTPS)
# EMAIL=your-email@example.com
# DOMAIN=localhost
