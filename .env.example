# OTRS MCP Server - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Ambiente (development ou production)
# Em production, JWT_SECRET é obrigatório
OTRS_ENV=development

# OTRS (obrigatorio)
OTRS_BASE_URL=https://your-otrs-instance/otrs/nph-genericinterface.pl/Webservice/TestInterface
OTRS_USERNAME=your-username
OTRS_PASSWORD=your-password

# OTRS (opcional)
OTRS_VERIFY_SSL=true
OTRS_TIMEOUT=30
OTRS_DEBUG=false
OTRS_DEFAULT_QUEUE=Raw
OTRS_DEFAULT_STATE=new
OTRS_DEFAULT_PRIORITY=3 normal
OTRS_DEFAULT_TYPE=
OTRS_WEB_BASE_URL=https://your-otrs-instance/otrs

# Opcionais - Se preenchidos, criam listas suspensas (dropdown) no painel web
OTRS_VALID_QUEUES=Suporte,Infraestrutura,Financeiro,Atendimento
OTRS_VALID_TYPES=Incidente,Requisicao de Servico,Duvida

# CORS
OTRS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# JWT (obrigatorio para auth do frontend)
OTRS_JWT_SECRET=change-me-in-production-use-a-real-secret-min-32-chars
OTRS_JWT_EXPIRE_MINUTES=480

# Admin padrao (criado automaticamente na primeira execucao)
OTRS_ADMIN_USER=admin
OTRS_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# MCP Server
OTRS_MCP_TRANSPORT=http
OTRS_MCP_HOST=0.0.0.0
OTRS_MCP_PORT=8001

# Database
OTRS_DB_PATH=/data/otrs-mcp.db

# Monitoramento de atividade
OTRS_ACTIVITY_FILE=/data/activity.json
OTRS_ACTIVITY_MAX_EVENTS=1000

# HTTPS (via Nginx no host)
# O certificado SSL é gerenciado pelo Nginx + Certbot no servidor.
# Ver nginx/mcp.conf para a configuração.

# Subpath (opcional — para dominio compartilhado com varios MCPs)
# Se todos os MCPs ficam em mcp.dominio.com, cada um num path diferente:
#   VITE_BASE_PATH=/otrs/  → acesso em https://mcp.dominio.com/otrs/
# Padrao: / (raiz, dominio dedicado)
# VITE_BASE_PATH=/otrs/

# OpenTelemetry (opcional — descomente para habilitar)
# O backend usa zero-code auto-instrumentacao via opentelemetry-instrument.
# O frontend envia traces do browser para o collector via OTLP HTTP.
#
# OTEL_TEMPO_ENDPOINT — URL do Tempo/Mimir que recebe OTLP HTTP
#   Ex: http://172.31.x.x:4318 (IP da EC2 do Grafana)
#
# VITE_OTEL_ENDPOINT — URL publica do collector para o browser
#   Ex: https://seu-dominio/otel (proxy via Nginx)
#
# OTEL_TEMPO_ENDPOINT=http://172.31.x.x:4318
# VITE_OTEL_ENDPOINT=https://seu-dominio/otel
